// Lezer grammar for the TikZ subset the editor models.
//
// Design rules (DECISIONS.md D5, D9):
// - Every token is named, so every byte of the input ends up in a named leaf
//   node. Whitespace and comments are named skip tokens for the same reason.
// - Only known TikZ commands get structure. Anything else is kept as generic
//   tokens (Opaque, UnknownPathItem, or plain document text), never dropped.
// - Tokens are contextual: each context (document text, picture body, path,
//   options, coordinates) has its own text token, so a word like "at" is only
//   a keyword where TikZ would treat it as one.

@precedence { pictureOptions }

@top Document { topItem* }

@skip { Whitespace | Comment }

// ---------------------------------------------------------------- document

topItem {
  TikzPicture |
  Tikzset |
  TikzStyle |
  UseTikzLibrary |
  topCs |
  Text |
  Group
}

topCs { ControlSequence | NodeKw | DrawKw | PathKw | FillKw | FilldrawKw | CoordinateKw | ForeachKw | MatrixKw }

anyCs { topCs | TikzsetKw | TikzstyleKw | UseTikzLibraryKw }

// Pictures can sit inside groups, e.g. \resizebox{\linewidth}{!}{...}.
Group { "{" groupItem* "}" }

groupItem { anyCs | Text | Group | TikzPicture }

Tikzset { TikzsetKw OptionBlock }

// \tikzstyle{name}=[...], \tikzstyle{name}+=[...] and \tikzstyle name=[...].
TikzStyle { TikzstyleKw StyleName ("=" | "+=") Options }

StyleName { OptionBlock | OptText+ }

UseTikzLibrary { UseTikzLibraryKw OptionBlock }

// ---------------------------------------------------------------- picture

TikzPicture { BeginTikz PictureOptions? bodyItem* EndTikz }

// Options directly after \begin{tikzpicture}. The precedence marker makes a
// leading "[...]" picture options rather than an Opaque item.
PictureOptions { Options !pictureOptions }

bodyItem {
  PathStatement |
  NodeStatement |
  CoordinateStatement |
  Tikzset |
  TikzStyle |
  UseTikzLibrary |
  Foreach |
  MatrixStatement |
  BodyGroup |
  Opaque
}

// A brace group in a picture body. It is either a scope ("{[red] \draw...;}")
// or the argument of an unknown command (\begin{scope}, \pgfonlayer{...}).
// The grammar can't tell which; the semantic layer decides from context.
BodyGroup { "{" bodyItem* "}" }

Opaque { ControlSequence | BodyText | Options }

PathStatement { (DrawKw | PathKw | FillKw | FilldrawKw) pathItem* ";" }

NodeStatement { NodeKw nodePart* Label pathItem* ";" }

// \coordinate is \path coordinate, so the path can go on:
// "\coordinate (a) at (0,0) coordinate (b) at (1,0);". The continuation can't
// start with "(" or "[", which would still belong to the first coordinate.
CoordinateStatement { CoordinateKw nodePart* coordinateTail? ";" }

coordinateTail {
  (PathCoordinate | PathNode | PathOperator | PathKeyword | UnknownPathItem | RelativeCoordinate) pathItem*
}

nodePart { Options | NodeName | AtClause }

NodeName { "(" coordItem* ")" }

AtClause { AtKw Coordinate }

Label { "{" groupItem* "}" }

// \foreach is always kept as-is. Its body is the next statement or group.
Foreach { ForeachKw foreachHead* InKw foreachList foreachBody }

foreachHead { ControlSequence | BodyText | Options }

foreachList { BodyGroup | ControlSequence }

foreachBody { BodyGroup | PathStatement | NodeStatement | CoordinateStatement | Foreach }

// \matrix is kept as-is. Its cells are document-like text.
MatrixStatement { MatrixKw nodePart* Group ";" }

// ---------------------------------------------------------------- paths

pathItem {
  Coordinate |
  RelativeCoordinate |
  PathOperator |
  Options |
  PathNode |
  PathCoordinate |
  PathKeyword |
  UnknownPathItem
}

Coordinate { "(" coordItem* ")" }

RelativeCoordinate { ("+" | "++") Coordinate }

PathOperator { "--" | "-|" | "|-" | ".." }

PathNode { NodeWordKw nodePart* Label }

PathCoordinate { CoordinateWordKw Options? NodeName AtClause? }

PathKeyword {
  ToKw | EdgeKw | ControlsKw | AndKw | CycleKw |
  RectangleKw | CircleKw | EllipseKw | ArcKw | GridKw
}

UnknownPathItem { ControlSequence | PathWord | PathOther | Group }

coordItem { CoordText | "-|" | "|-" | Coordinate | Options | Group | ControlSequence }

// ---------------------------------------------------------------- options

Options { "[" optionList "]" }

// Brace groups inside options (style bodies, \tikzset, \usetikzlibrary) are
// parsed as option lists too; the semantic layer decides what they mean.
// Inside braces a ";" is part of the value (pic code={...;}), so these lists
// accept it. In square brackets it stays an error, so an unclosed "[" stops
// at the end of its statement.
OptionBlock { "{" blockOptionList "}" }

optionList { Option? ("," Option?)* }

blockOptionList { BlockOption? ("," BlockOption?)* }

Option { OptionKey ("=" OptionValue?)? }

OptionKey { optToken+ }

OptionValue { (optToken | "=")+ }

BlockOption[@name=Option] { BlockOptionKey ("=" BlockOptionValue?)? }

BlockOptionKey[@name=OptionKey] { blockOptToken+ }

BlockOptionValue[@name=OptionValue] { (blockOptToken | "=")+ }

optToken { OptText | anyCs | OptionBlock | Options }

blockOptToken { optToken | ";" }

// ---------------------------------------------------------------- keywords

NodeKw { @specialize<ControlSequence, "\\node"> }
DrawKw { @specialize<ControlSequence, "\\draw"> }
PathKw { @specialize<ControlSequence, "\\path"> }
FillKw { @specialize<ControlSequence, "\\fill"> }
FilldrawKw { @specialize<ControlSequence, "\\filldraw"> }
CoordinateKw { @specialize<ControlSequence, "\\coordinate"> }
TikzsetKw { @specialize<ControlSequence, "\\tikzset"> }
TikzstyleKw { @specialize<ControlSequence, "\\tikzstyle"> }
UseTikzLibraryKw { @specialize<ControlSequence, "\\usetikzlibrary"> }
ForeachKw { @specialize<ControlSequence, "\\foreach"> }
MatrixKw { @specialize<ControlSequence, "\\matrix"> }

InKw { @extend<BodyText, "in"> }

NodeWordKw { @specialize<PathWord, "node"> }
CoordinateWordKw { @specialize<PathWord, "coordinate"> }
AtKw { @specialize<PathWord, "at"> }
ToKw { @specialize<PathWord, "to"> }
EdgeKw { @specialize<PathWord, "edge"> }
ControlsKw { @specialize<PathWord, "controls"> }
AndKw { @specialize<PathWord, "and"> }
CycleKw { @specialize<PathWord, "cycle"> }
RectangleKw { @specialize<PathWord, "rectangle"> }
CircleKw { @specialize<PathWord, "circle"> }
EllipseKw { @specialize<PathWord, "ellipse"> }
ArcKw { @specialize<PathWord, "arc"> }
GridKw { @specialize<PathWord, "grid"> }

// ---------------------------------------------------------------- tokens

@tokens {
  Whitespace { $[ \t\r\n]+ }

  Comment { "%" ![\n]* }

  ControlSequence { "\\" ($[a-zA-Z@]+ | ![a-zA-Z@]) }

  // Recognised as single tokens so the picture boundaries need no lookahead.
  // "\begin {tikzpicture}" (with a space) falls back to plain document text.
  BeginTikz { "\\begin{tikzpicture}" }
  EndTikz { "\\end{tikzpicture}" }

  // Document text and brace-group content.
  Text { ![\\{}% \t\r\n]+ }

  // Picture-body text. It can't start with "[" so that "[" opens Options.
  BodyText { ![\\{}%[ \t\r\n] ![\\{}% \t\r\n]* }

  OptText { ![\\{}%[\],=; \t\r\n]+ }

  // Coordinate text stops before "-|" so "(a.north-|b)" splits correctly. A
  // dash that isn't followed by another text character is a token by itself.
  coordChar { ![\\{}%[\]();|\- \t\r\n] }
  CoordText { (coordChar | "-" coordChar)+ | "-" }

  PathWord { $[a-zA-Z]+ }

  PathOther { ![\\{}%[\]();a-zA-Z+\-|. \t\r\n]+ }

  "(" ")" "[" "]" "{" "}" ";" "," "=" "+="
  "--" "-|" "|-" ".." "+" "++"

  @precedence { BeginTikz, EndTikz, ControlSequence }
  @precedence { "-|", CoordText }
  @precedence { "+=", OptText }
}
