% pgfsys-tikzflow.def: the PGF driver of TikZFlow's accurate preview.
%
% SPDX-License-Identifier: GPL-3.0-or-later
% Part of TikZFlow (https://github.com/LoganAlexanderBurnett/tikzflow).
% Built on pgf's own pgfsys-dvisvgm.def (Copyright 2019 by Till Tantau),
% which may be distributed and/or modified under the LaTeX Project Public
% License and/or the GNU General Public License; this file takes the GPL.
% It is not pgfsys-dvisvgm.def: that file is loaded unchanged and only the
% definitions below are replaced (DECISIONS.md D15, D66).
%
% TeX writes pgf's SVG fragments into the DVI file as dvisvgm specials, and
% TikZFlow's own DVI to SVG converter (src/engine/dvisvg.ts) draws them with
% the characters and rules around them. The converter draws characters as
% paths with no stroke of their own, so the changes are:
%  1. Text no longer switches the SVG output into "box mode". In box mode a
%     colour change set only the fill, and every scope opened in a TeX box
%     (a node's text) added stroke="none", so drawings inside a box lost their
%     strokes: the borders of \matrix cells, and every line of a picture nested
%     in a node's text (\node{\tikz ...}). Colour changes now set the stroke as
%     well, as they do outside boxes.
%  2. Boxes are placed without stroke="none", for the same reason.
%  3. The outermost picture says where it is with a special,
%       \special{tikzflow:picture <minx> <miny> <width> <height>}
%     at the lower left corner of its bounding box, in TeX points, so the
%     preview can lay the compiled picture exactly over TikZ's coordinates.

\ProvidesFile{pgfsys-tikzflow.def}[2026/10/09 TikZFlow preview driver, based on pgfsys-dvisvgm.def]

\input{pgfsys-dvisvgm.def}

% 1. No box mode: text is a scope like any other.
\def\pgfsys@begin@text{\pgfsys@beginscope}
\def\pgfsys@end@text{\pgfsys@endscope}

% 2. Boxes keep the stroke of the scope they are placed in.
\def\pgfsys@hbox#1{%
  {%
    \setbox#1=\hbox{\box#1}%
    \wd#1=0pt%
    \ht#1=0pt%
    \dp#1=0pt%
    \pgfsys@begin@idscope%
    \pgfsys@invoke{<g transform="scale(-1.00375,1.00375)translate({?x},{?y})scale(-1,-1)">}\box#1\pgfsys@invoke{</g>}%
    \pgfsys@end@idscope%
  }%
}

\def\pgfsys@hboxsynced#1{%
  {%
    \setbox#1=\hbox{\box#1}%
    \wd#1=0pt%
    \ht#1=0pt%
    \dp#1=0pt%
    \pgfsys@begin@idscope%
    \pgfsys@beginscope%
    \pgflowlevelsynccm%
    \pgfsys@invoke{<g transform="scale(-1.00375,1.00375)translate({?x},{?y})scale(-1,-1)">}\box#1\pgfsys@invoke{</g>}%
    \pgfsys@endscope%
    \pgfsys@end@idscope%
  }%
}

% 3. pgfsys-dvisvgm.def's \pgfsys@typesetpicturebox, with the picture's box
% written for the converter.
\def\pgfsys@typesetpicturebox#1{%
  \pgf@ya=\pgf@shift@baseline\relax%
  \advance\pgf@ya by-\pgf@picminy\relax%
  %
  %
  \advance\pgf@picmaxy by-\pgf@picminy\relax% maxy is now the height
  \advance\pgf@picmaxx by-\pgf@picminx\relax% maxx is now the width
  \setbox#1=\hbox{\hskip-\pgf@picminx\lower\pgf@picminy\box#1}%
  \ht#1=\pgf@picmaxy%
  \wd#1=\pgf@picmaxx%
  \dp#1=0pt%
  \leavevmode%
  \pgf@xa=\pgf@trimleft@final\relax  \ifdim\pgf@xa=0pt \else\kern\pgf@xa\fi%
  \raise-\pgf@ya\hbox{%
    \ifpgf@sys@svg@inpicture
      \box#1%
    \else
      \special{tikzflow:picture \pgf@sys@tonumber\pgf@picminx\space\pgf@sys@tonumber\pgf@picminy\space\pgf@sys@tonumber\pgf@picmaxx\space\pgf@sys@tonumber\pgf@picmaxy}%
      \special{dvisvgm:bbox \pgf@sys@tonumber\pgf@picmaxx\space\pgf@sys@tonumber\pgf@picmaxy}%
      \special{dvisvgm:bbox lock}%
      \box#1%
      \special{dvisvgm:bbox unlock}%
    \fi}%
  \pgf@xa=\pgf@trimright@final\relax \ifdim\pgf@xa=0pt \else\kern\pgf@xa\fi%
}

\endinput
