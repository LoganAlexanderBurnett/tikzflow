{
  "name": "tikzflow",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "grammar": "lezer-generator --typeScript src/parser/tikz.grammar -o src/parser/parser.ts",
    "predev": "npm run grammar",
    "dev": "vite",
    "prebuild": "npm run grammar",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "npm run grammar",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run grammar",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "grammar:inspect": "node scripts/grammar-inspect.ts",
    "grammar:bench": "node scripts/grammar-bench.ts",
    "corpus:report": "node scripts/corpus-report.ts",
    "gen:font-metrics": "node scripts/gen-font-metrics.ts",
    "fetch-engines": "node scripts/fetch-engines.ts",
    "bench-engines": "node scripts/bench-engines.ts",
    "compare-engines": "node scripts/compare-engines.ts",
    "fidelity": "node scripts/fidelity.ts",
    "layout:bench": "node scripts/layout-bench.ts",
    "golden:review": "node scripts/golden-review.ts",
    "dvicheck": "node scripts/dvicheck.ts",
    "pdfcheck": "node scripts/pdfcheck.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.10",
    "@preact/signals": "^2.11.3",
    "katex": "^0.19.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "xz-decompress": "^0.2.3"
  }
}
